# GroundTruth.ai Environment Configuration Example
PROJECT_NAME="GroundTruth.ai"
TAGLINE="Answers you can verify."

# Security
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS Origins (comma separated)
BACKEND_CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

# Database Configuration
# Production with Docker Compose:
DATABASE_URL="postgresql://groundtruth_user:groundtruth_pass@postgres:5432/groundtruth_db"
# Local development with PostgreSQL:
# DATABASE_URL="postgresql://groundtruth_user:groundtruth_pass@localhost:5432/groundtruth_db"
# Lightweight development / standalone test runner:
# DATABASE_URL="sqlite:///./groundtruth.db"

# AI Provider Configuration
# Options: "mock", "openai", "gemini", "anthropic"
LLM_PROVIDER="mock"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"

# Embedding Provider Configuration
# Options: "mock", "openai"
EMBEDDING_PROVIDER="mock"
EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_DIMENSION=1536

# RAG & Evidence Verification Settings
CHUNK_SIZE=600
CHUNK_OVERLAP=100
RETRIEVAL_TOP_K=5
RETRIEVAL_THRESHOLD=0.45

# Upload Limits
MAX_UPLOAD_SIZE_BYTES=20971520
